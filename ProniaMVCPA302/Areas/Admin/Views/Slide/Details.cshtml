
@model Slide

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Slide Details</h4>
                    <a class="btn btn-light" asp-action="Index">
                        <i class="mdi mdi-arrow-left"></i> Back to list
                    </a>
                </div>
                <p class="card-description">
                    Viewing details for slide <strong>#@Model.Id</strong>
                </p>

                <div class="row">
                    <div class="col-md-5 mb-4 mb-md-0">
                        <img src="~/assets/images/website-images/@Model.Image"
                             alt="@Model.Title"
                             class="img-fluid rounded shadow-sm w-100"
                             style="object-fit:cover;max-height:340px;"
                             onerror="this.onerror=null;this.src='/admin/images/faces/face1.jpg';" />
                    </div>
                    <div class="col-md-7">
                        <table class="table table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <th style="width:160px;">Id</th>
                                    <td>@Model.Id</td>
                                </tr>
                                <tr>
                                    <th>Title</th>
                                    <td>@Model.Title</td>
                                </tr>
                                <tr>
                                    <th>Subtitle</th>
                                    <td>@Model.SubTitle</td>
                                </tr>
                                <tr>
                                    <th>Order</th>
                                    <td><span class="badge bg-primary">@Model.Order</span></td>
                                </tr>
                                <tr>
                                    <th>Image file</th>
                                    <td>@Model.Image</td>
                                </tr>
                                <tr>
                                    <th>Created at</th>
                                    <td>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                                </tr>
                            </tbody>
                        </table>

                        <h6 class="mt-4">Description</h6>
                        <p class="text-muted">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>
                </div>

                <div class="mt-4">
                    <a class="btn btn-warning me-2" title="Edit">
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                    <a class="btn btn-danger me-2" title="Delete">
                        <i class="mdi mdi-delete"></i> Delete
                    </a>
                    <a class="btn btn-light" asp-action="Index">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>