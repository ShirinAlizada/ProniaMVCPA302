@model List<SlideItemVM>
@{
    int count = 0;
}

<div class="row">

    <div class="col-lg-12 grid-margin stretch-card">

        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Slide</h4>
                <a class="btn btn-success" asp-action="Create">Create</a>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    No
                                </th>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Title
                                </th>
                                <th>
                                    Order
                                </th>
                                <th>
                                    Creation Date
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (SlideItemVM slideVM in Model)
                            {
                                count++;
                                <tr>
                                    <td class="py-1">
                                        
                                    </td>
                                    <td>
                                        <img src="~/assets/images/website-images/@slideVM.Image" alt="@slideVM.Title" />
                                    </td>
                                    <td>
                                        @slideVM.Title
                                    </td>
                                    <td>
                                        @slideVM.Order
                                    </td>
                                    <td>
                                        @slideVM.CreatedAt
                                    </td>
                                    <td>
                                        <a asp-action="update" asp-route-id="@slideVM.Id" class="btn btn-warning"><i class="mdi mdi-pen"></i></a>
                                        <a asp-action="delete" asp-route-id="@slideVM.Id" class="btn btn-danger"><i class="mdi mdi-delete"></i></a>
                                        <a asp-action="details" asp-route-id="@slideVM.Id" class="btn btn-primary"><i class="mdi mdi-open-in-new"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>